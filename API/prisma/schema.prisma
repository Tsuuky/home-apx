// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DjuDay {
  date      DateTime @id
  lat       Float
  lon       Float
  tmeanC    Float
  baseC     Float
  dju       Float
  source    String
  fetchedAt DateTime @default(now())
}

model FetchLock {
  id        Int      @id @default(1)
  isRunning Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum StockMovementType {
  INITIAL // mise en stock initiale (point de départ)
  DELIVERY // livraison
  ADJUST // correction inventaire
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime?
  baseC     Float     @default(18)
  createdAt DateTime  @default(now())

  pellets PelletDaily[]

  @@index([startDate, endDate])
}

model PelletDaily {
  date     DateTime @id // 1 ligne par jour
  kg       Float
  bags     Int? // optionnel (ex 2 sacs)
  bagKg    Float? // optionnel (ex 15)
  note     String?
  seasonId Int?
  season   Season?  @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())

  @@index([seasonId, date])
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  type      StockMovementType
  date      DateTime
  kg        Float // + entrée, - sortie (mais ici on fera surtout + et correction)
  note      String?
  createdAt DateTime          @default(now())

  @@index([date])
}
